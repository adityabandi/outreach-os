# --- Required (app + worker) -------------------------------------------------
# Postgres connection for the application role (RLS binds to this role).
DATABASE_URL=postgres://outreach_app:outreach_app@localhost:5433/outreach_os
# Session cookie HMAC secret. Generate: openssl rand -hex 32
# Production refuses to start sessions with the placeholder value.
SESSION_SECRET=change-me

# --- Optional ----------------------------------------------------------------
# Public base URL used in outbound email links (unsubscribe). Default http://localhost:3100
# PUBLIC_BASE_URL=https://outreach.example.com
# Dedicated HMAC secret for unsubscribe tokens (falls back to SESSION_SECRET).
# UNSUB_SECRET=
# Webhook signature secrets: one per provider, e.g. WEBHOOK_SECRET_REWARDFUL.
# WEBHOOK_SECRET_DEV is the fallback for local development only.
# WEBHOOK_SECRET_DEV=dev-webhook-secret
# Worker poll cadence in milliseconds (default 3000).
# WORKER_POLL_MS=3000

# --- Gmail adapter (real sends; leave unset to stay on the mock mailbox) -----
# GMAIL_CLIENT_ID=...
# GMAIL_CLIENT_SECRET=...
# Per-sender refresh token; the integration row's secret ref names the variable.
# GMAIL_REFRESH_TOKEN_LARA=...

# --- One-off bootstrap (first deployment) ------------------------------------
# BOOTSTRAP_ADMIN_EMAIL=you@company.com
# BOOTSTRAP_ADMIN_NAME=Your Name
# BOOTSTRAP_ORG_NAME=Your Organization
# BOOTSTRAP_WORKSPACE_NAME=Main
# BOOTSTRAP_WORKSPACE_SLUG=main
# BOOTSTRAP_TIMEZONE=UTC

# --- Demo data (disposable demo deployments only) -----------------------------
# SEED_DEMO=true
# SEED_DATABASE_URL=postgres://outreach:outreach@localhost:5433/outreach_os

# --- Local development only (embedded Postgres) -------------------------------
# PGDATA=$HOME/pgdata
# PGPORT=5433
