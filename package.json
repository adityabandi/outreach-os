    "typecheck": "tsc --noEmit",
    "db:bootstrap": "tsx src/db/bootstrap.ts"
  },
  "dependencies": {
    "next": "15.5.4",
    "pg": "^8.13.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
